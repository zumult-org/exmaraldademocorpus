    <Components>
        <SpokenCorpusProfile>
            <GeneralInfo ComponentId="clarin.eu:cr1:c_1422885449330">
                <Name xml:lang="eng">EXMARaLDA Demo corpus 1.2</Name>
                <Title xml:lang="eng">EXMARaLDA Demo corpus 1.2</Title>
                <!-- The PID of the resource. -->
                <PID></PID>
                <Description xml:lang="eng">
                    The EXMARaLDA Demo Corpus is a small corpus originally designed for demonstrating the functionality of the EXMARaLDA system.
                    It consists of a selection of short transcribed audio and video recordings in various languages.
                    Version 1.2 is a subset of version 1.1, curated for the Transcription+ project, with the main aim of demonstrating the use
                    of ISO 24624:2016 Language resource management — Transcription of spoken language.
                </Description>
                <Keyword xml:lang="eng">L1 data</Keyword>
                <Keyword xml:lang="eng">EXMARaLDA</Keyword>
                <Keyword xml:lang="eng">ISO 24624:2016</Keyword>
                <ResourceClass>corpus</ResourceClass>
                <PublicationDate>2026</PublicationDate>
                <LifeCycleStatus>released</LifeCycleStatus>
                <LegalOwner>Hamburger Zentrum für Sprachkorpora, Max-Brauer-Allee 60 / D-22765 Hamburg, corpora@uni-hamburg.de</LegalOwner>
