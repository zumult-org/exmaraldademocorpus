    <Communication Id="C_NTVshniki" Name="NTVshniki">
      <Setting>
        <Description />
        <Person>C_NTVshniki.SL</Person>
        <Person>C_NTVshniki.KG</Person>
        <Person>C_NTVshniki.SP</Person>
        <Person>C_NTVshniki.AK</Person>
        <Person>C_NTVshniki.AL</Person>
      </Setting>
      <Description>
        <Key Name="Background information" xml:lang="eng">The two businessmen were actually supposed to be discussing the financial crisis – but during the programme on Russian television, the billionaire Alexander Lebedev suddenly became violent and knocked his neighbour off his seat. (www.spiegel.de)</Key>
        <Key Name="Hintergrundinformation" xml:lang="deu">Eigentlich sollten die beiden Unternehmer über die Finanzkrise diskutieren - aber während der Sendung im russischen Fernsehen wurde der Milliardär Alexander Lebedew plötzlich handgreiflich und prügelte seinen Nachbarn vom Sitz.(www.spiegel.de)</Key>
        <Key Name="Communication type">interview</Key>
        <Key Name="Project name">EXMARaLDA DemoKorpus</Key>
        <Key Name="Source">Excerpt from the program NTVshniki on 16.09.2011</Key>
        <Key Name="Quelle">Auszug aus dem Programm NTVshniki vom 16.09.2011</Key>
      </Description>
      <Language Type="Communication">
        <LanguageCode>rus</LanguageCode>
        <Description />
      </Language>
      <Location Type="Communication">
        <City>Moscow</City>
        <Country>Russia</Country>
