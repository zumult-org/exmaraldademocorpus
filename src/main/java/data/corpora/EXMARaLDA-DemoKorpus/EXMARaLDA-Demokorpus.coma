    <Communication Id="C_RudioVoellerWutausbruch" Name="Rudi Völler: Wutausbruch">
      <Setting>
        <Person>C_RudioVoellerWutausbruch.WH</Person>
        <Person>C_RudioVoellerWutausbruch.RV</Person>
        <Description />
      </Setting>
      <Description>
        <Key Name="Background information" xml:lang="eng">The European Championship qualifying match against Iceland ended 0–0. Before the live link to Reykjavik, the presenters of the sports programme, Gerhard Delling and Günter Netzer – who can still be seen on a monitor in the studio – assessed the match and the performance of the German national team. </Key>
        <Key Name="Hintergrundinformation" xml:lang="deu">Das Fußball-EM-Qualifikationsspiels gegen Island endete 0:0. Vor der Live-Schaltung nach Reykjavik haben die Moderatoren der Sportsendung, Gerhard Delling und Günter Netzer, die noch auf einem Monitor im Studio zu sehen sind, das Spiel bzw. die Leistung der deutschen Nationalmannschaft bewertet. </Key>
        <Key Name="Communication type">television interview</Key>
        <Key Name="Project name">EXMARaLDA DemoKorpus</Key>
        <Key Name="Source">Sportschau (ARD); recorded and  provided by Dr. Wilfried Schütte (Institute for the German Language, Mannheim).</Key>
        <Key Name="Quelle">Sportschau (ARD); Aufgenommen und bereitgestellt von Dr. Wilfried Schütte (Institut für Deutsche Sprache, Mannheim).</Key>
      </Description>
      <Language Type="Communication">
        <LanguageCode>deu</LanguageCode>
        <Description />
      </Language>
      <Location Type="Communication">
        <Period>
          <PeriodStart>2003-09-06T21:30:00</PeriodStart>
          <PeriodExact>false</PeriodExact>
          <PeriodDuration>0</PeriodDuration>
        </Period>
        <City>Reykjavik</City>
        <Country>Iceland</Country>
        <Description />
      </Location>
